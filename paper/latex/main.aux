\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Nsight Systems ($C{=}1$, 1024-in/64-out) host-dispatch and GPU utilization progression. \textbf  {(a)}~Operator fusion (\texttt  {\footnotesize  S5-C}) cuts CPU launch calls $3.03\times $ and bucketed CUDA graphs (\texttt  {\footnotesize  S6-C}) cut them another $50.6\times $ to 476 calls (63 graph launches). \textbf  {(b)}~GPU idle collapses from $53.5\%$ (\texttt  {\footnotesize  S4-C}) to $29.0\%$ (\texttt  {\footnotesize  S5-C}) to $9.0\%$ (\texttt  {\footnotesize  S6-C}), yielding an $8.64$~ms decode step ($19.0\%$ faster than \texttt  {\footnotesize  stage-0-vllm}'s $10.67$~ms).}}{5}{figure.caption.6}\protected@file@percent }
\newlabel{fig:nsys}{{4}{5}{Nsight Systems ($C{=}1$, 1024-in/64-out) host-dispatch and GPU utilization progression. \textbf {(a)}~Operator fusion (\stage {S5-C}) cuts CPU launch calls $3.03\times $ and bucketed CUDA graphs (\stage {S6-C}) cut them another $50.6\times $ to 476 calls (63 graph launches). \textbf {(b)}~GPU idle collapses from $53.5\%$ (\stage {S4-C}) to $29.0\%$ (\stage {S5-C}) to $9.0\%$ (\stage {S6-C}), yielding an $8.64$~ms decode step ($19.0\%$ faster than \stage {stage-0-vllm}'s $10.67$~ms)}{figure.caption.6}{}}
